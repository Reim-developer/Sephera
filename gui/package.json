{
  "name": "sephera-gui",
  "private": true,
  "version": "0.7.1",
  "type": "module",
  "description": "The graphical front-end for Sephera: a React client over the Rust analysis crates.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
