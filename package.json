{
  "name": "sephera-monorepo",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm --filter sephera-mcp build",
    "test": "pnpm --filter sephera-mcp test",
    "typecheck": "pnpm --filter sephera-mcp typecheck",
    "check:mcp-package": "python scripts/check_mcp_package.py"
  },
  "pnpm": {
    "neverBuiltDependencies": [
      "sephera-mcp"
    ]
  }
}