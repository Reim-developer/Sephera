# One newline convention for the whole tree: LF in the repository.
#
# This repo is developed on Windows, where the default `core.autocrlf = true`
# converts to CRLF on checkout. That made every commit warn `LF will be replaced
# by CRLF the next time Git touches it` -- 17 times for a single file -- and left
# the working tree disagreeing with the index depending on which tool wrote the
# file. A Python script writing with `newline=""` produced LF; one writing
# without it produced CRLF; PowerShell's here-strings produced something else
# again.
#
# `text=auto eol=lf` is the whole fix. Git still detects binary files and leaves
# them alone, so the icon and image assets are untouched. What it stops is the
# ambiguity: the repository stores LF, and anything that reads it gets LF.

* text=auto eol=lf

# Explicitly binary, so nothing ever tries to normalise them. `text=auto` should
# catch these, but the icons under `gui/src-tauri/icons/` are generated by a
# Python script rather than authored, and a mangled ICO fails the Tauri build
# with `icon.ico not found` -- an error that names the symptom and not the cause.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.pdf binary
*.zip binary
*.gz binary
*.snap text

# Generated files that should never be normalised either way: a diff of these is
# a diff of a whole file, and line endings are the least interesting thing in it.
Cargo.lock linguist-generated=true
package-lock.json linguist-generated=true
