    "rust",
    "tree-sitter"
  ],
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/Reim-developer/Sephera",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Reim-developer/Sephera.git"
  },
  "bugs": {
    "url": "https://github.com/Reim-developer/Sephera/issues"
  },
  "bin": {
    "sephera-mcp": "dist/launcher.js"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
